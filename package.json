{
  "name": "wegrow-clientportal",
  "version": "1.0.0",
  "private": true,
  "description": "WeGrow B School Client Portal - Full Stack Transformation & Attendance Portal",
  "workspaces": [
    "wegrow-clientportal-frontend",
    "wegrowclientportal"
  ],
  "scripts": {
    "postinstall": "npm --prefix wegrowclientportal install",
    "build": "npm --prefix wegrowclientportal run build",
    "start": "npm --prefix wegrowclientportal run start:prod",
    "build:frontend": "npm --prefix wegrow-clientportal-frontend run build",
    "build:backend": "npm --prefix wegrowclientportal run build",
    "dev:frontend": "npm --prefix wegrow-clientportal-frontend run dev",
    "dev:backend": "npm --prefix wegrowclientportal run dev",
    "start:backend": "npm --prefix wegrowclientportal run start:prod",
    "db:view": "npm --prefix wegrowclientportal run db:view"
  }
}
